<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.vobs</groupId>
    <artifactId>vobs-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>vobs-consent</artifactId>
  <name>VOBS Consent</name>
  <description>
    Quản lý sự đồng ý (consent) của khách hàng theo Luật Bảo vệ dữ liệu cá nhân số 91/2025/QH15 và Thông tư 64/2024/TT-NHNN: cấp, xem, thu hồi theo phạm vi dữ liệu và thời hạn, có log kiểm toán chuỗi hash.
  </description>
  <url>https://github.com/xvalleycorp/vobs/tree/main/vobs-consent</url>

  <dependencies>
    <!-- Lớp HTTP dùng máy chủ HTTP có sẵn trong JDK; Jackson để đọc, ghi JSON -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <!-- Chính sách nhận yêu cầu consent viết bằng bảng quyết định (ConsentPolicy) -->
    <dependency>
      <groupId>vn.io.dxa.rulestone</groupId>
      <artifactId>rulestone-core</artifactId>
    </dependency>
    <!-- Lưu consent và log kiểm toán vào PostgreSQL bằng JDBC thuần, không dùng ORM -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
    </dependency>
  </dependencies>
</project>
