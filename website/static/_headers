# Header bảo mật cho mọi trang. Không có script hay style inline nào, nên CSP chặt được.
# Ngoại lệ duy nhất: Cloudflare Web Analytics (bật ở cấp zone dxa.io.vn, tự chèn beacon, không dùng cookie).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# Redoc chèn style lúc chạy (styled-components) và tạo Web Worker từ blob cho ô tìm kiếm
/api/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; img-src 'self' data:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'

/en/api/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; img-src 'self' data:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'

# Font không đổi theo phiên bản nên cache lâu
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
