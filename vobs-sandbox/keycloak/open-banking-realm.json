{
  "realm": "open-banking",
  "displayName": "VOBS sandbox",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 600,
  "clients": [
    {
      "clientId": "fintech-a",
      "name": "Fintech mẫu (chỉ nhóm truy vấn thông tin)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "sandbox-fintech-a-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "wallet-b",
      "name": "Trung gian thanh toán mẫu",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "sandbox-wallet-b-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "bank-c",
      "name": "Ngân hàng mẫu",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "sandbox-bank-c-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false
    }
  ]
}
